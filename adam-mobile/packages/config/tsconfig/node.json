{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@adam/config node",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false,
    "types": ["node"]
  }
}
