[Unit]
Description=ADAM v40 — Autonomous Desktop AI Module
# Needs the network up for the Gemini Live API + laptop-agent mDNS discovery.
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/adam
# -u = unbuffered, so prints reach journald live (journalctl -u adam -f).
# config.py loads /home/pi/adam/.env itself (GEMINI_API_KEY etc.), so no
# EnvironmentFile line is needed here.
ExecStart=/home/pi/adam/venv/bin/python -u /home/pi/adam/main.py

# main.py installs a SIGTERM handler that turns the camera off, centers the
# servo and flushes memory/conversation to disk, so the default SIGTERM stop
# is a clean shutdown. Give it time to finish that before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=15

# Auto-restart on crash (unhandled exception -> sys.exit(1)); a clean exit(0)
# will NOT restart. Backoff so a hard-failing start can't hammer the Pi.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
