# Railway Environment Variables — ADAM Relay Server
# Copy this to .env for local development. Never commit actual secrets.

# ── Gemini ──────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
# v27/v28 Python runtime uses this model.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# ── Firebase Admin (service account) ────────────────────────────────────────
# Download from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep newlines escaped as \n in a single line:
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Relay JWT Secret (must match RELAY_JWT_SECRET on Vercel exactly) ─────────
RELAY_JWT_SECRET=replace_with_strong_random_secret   # openssl rand -base64 32

# ── Internal tester UIDs that bypass all caps ───────────────────────────────
# Comma-separated Firebase UIDs. Keep this in sync with Vercel.
TESTER_UIDS=DUHBEYpqD1W0oInXMvVIrgN5pfG2,J18eb5xtHMVGTTOHoAguFfOgU7p2

# ── Trusted browser origins for WebSocket auth ─────────────────────────────
# Comma-separated list. For embedded iframe setups, include the iframe app
# origin itself (adam-demo-frontend.vercel.app), because WS origin is the
# iframe document origin, not the parent website origin.
ALLOWED_ORIGIN=https://adam-demo-frontend.vercel.app,https://dgentechnologies.com

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Auth migration safety (temporary) ─────────────────────────────────────
# Set to true only while migrating old frontend deployments that mint relay
# JWTs without iss/aud claims. Turn back to false after frontend is updated.
ALLOW_LEGACY_RELAY_TOKENS=false
