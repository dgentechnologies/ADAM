{
  "name": "@adam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ADAM backend — Fastify route stubs returning mock data (no real integrations yet)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@adam/types": "workspace:*",
    "@fastify/cors": "10.0.1",
    "fastify": "5.2.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@adam/config": "workspace:*",
    "@types/node": "22.10.2",
    "prisma": "6.1.0",
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
