# ADAM v32 — environment configuration template
# Copy this to .env and fill in real values. NEVER commit the real .env
# (it contains your live API key) — this file is the safe-to-share template.

# ── Required ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Vision (wired ESP32-CAM, Flow 2 — UART, not WiFi) ───────────────
PI_UART_PORT=/dev/serial0
PI_UART_BAUD=921600

# ── Laptop agent (mDNS auto-discovery handles IP normally) ──────────
LAPTOP_AGENT_PORT=8642
LAPTOP_AGENT_TOKEN=change_this_to_a_random_secret
# Only set this if mDNS is blocked on your router — normally leave unset
# and let auto-discovery find the laptop agent.
# LAPTOP_AGENT_IP=192.168.1.8
